rules_version = '2';

// Placeholder — deny-by-default. T-14 replaces this with the real per-collection rules
// (owner-only reads/writes on users/{uid}/records, public reads on publicRecords, write-only
// reports) plus a rules unit test suite. Do not weaken this without a test proving the new
// rule can't leak a private field — see 02-ARCHITECTURE.md §3, ADR-4.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
